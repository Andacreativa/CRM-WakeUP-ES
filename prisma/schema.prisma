generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id           Int       @id @default(autoincrement())
  nome         String
  paese        String    @default("Italia")
  email        String?
  telefono     String?
  partitaIva   String?
  via          String?
  cap          String?
  citta        String?
  provincia    String?
  iban         String?
  tipoImposta  String?   @default("IGIC Exenta")
  note         String?
  // Cliente portato da Social Media House: le sue fatture entrano nel
  // Rapporto SMH (ritenuta e fattura diretta a SMH per il compenso mensile).
  smh          Boolean   @default(false)
  createdAt    DateTime    @default(now())
  fatture      Fattura[]
  contratti    Contratto[]
  richiesteFattura RichiestaFattura[]
  rinnoviSiti  RinnovoSito[]
  contatti     Contatto[]
  leads        Lead[]
}

model Fattura {
  id            Int            @id @default(autoincrement())
  numero        String?
  data          DateTime?
  clienteId     Int?
  cliente       Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  contrattoId   Int?
  contratto     Contratto?     @relation(fields: [contrattoId], references: [id], onDelete: SetNull)
  azienda       String         @default("Spagna")
  aziendaNota   String?
  mese          Int
  anno          Int            @default(2025)
  importo       Float
  tipoIva       String         @default("iva")
  iva           Float          @default(21)
  pagato        Boolean        @default(false)
  inviata       Boolean        @default(false)
  dataInvio     DateTime?
  checkInvio    String         @default("in_attesa")
  // Presentata all'Agencia Tributaria (VeriFactu). Oggi è una spunta a mano,
  // come «Contab.» di Northstar; la scriverà il collegamento quando ci sarà.
  presentata    Boolean        @default(false)
  presentataIl  DateTime?
  // Annullata: la fattura resta nel registro (il numero non si riusa) ma
  // esce da totali, scadenze e riconciliazione. Non si elimina.
  annullata     Boolean        @default(false)
  annullataIl   DateTime?
  origine       String         @default("finance")
  metodo        String?
  commerciale   String? // storico (testo libero); oggi si usa commercialeId
  commercialeId Int?
  commercialeRef Dipendente?   @relation("FatturaCommerciale", fields: [commercialeId], references: [id], onDelete: SetNull)
  scadenza      DateTime?
  // Bozza: senza numero, si modifica e si elimina. Emessa: resta nel registro.
  stato         String         @default("emessa") // bozza | emessa
  emessaIl      DateTime?
  // Descrizione dell'operazione e righe (JSON [{ descrizione, quantita, prezzo }]).
  // Senza righe vale l'importo unico, come le fatture di prima.
  descrizione   String?
  voci          String         @default("[]")
  // A 0 %: esente (E1…E8) o non soggetta (N1, N2). Serve al registro VeriFactu.
  causaIgic     String?
  // Rettificativa (serie a parte) della fattura indicata. Per sostituzione
  // (S): porta gli importi giusti per intero e la fattura corretta esce dai
  // totali (annullata = true, mostrata come «Rettificata»). Per differenze
  // (I): porta solo la differenza, col suo segno.
  tipoFattura   String         @default("F1") // F1 | R1 | R2 | R3 | R4
  tipoRettifica String? // S | I
  rettificaDiId Int?
  rettificaDi   Fattura?       @relation("Rettifica", fields: [rettificaDiId], references: [id], onDelete: SetNull)
  rettifiche    Fattura[]      @relation("Rettifica")
  // VeriFactu: null = fattura non trasmessa da questa app (registrata a mano)
  vfStato       String? // in_coda | accettata | accettata_con_errori | rifiutata
  vfQr          String? // indirizzo di verifica AEAT che va nel QR
  createdAt     DateTime       @default(now())
  altriIngressi AltroIngresso[]
  spese         Spesa[]
  acconti       Acconto[]
  richiesta     RichiestaFattura?
  commissioni   PagamentoMensile[] @relation("CommissioneFattura")
  solleciti     Sollecito[]
  abbinamentiBancari AbbinamentoBancario[]
  registriVerifactu  RegistroVerifactu[]

  @@index([contrattoId])
  @@index([commercialeId])
  @@index([rettificaDiId])
}

// Registri di fatturazione VERI*FACTU: uno per ogni emissione, correzione o
// annullamento, concatenati per impronta nell'ordine in cui nascono. Non si
// modificano e non si eliminano: cambia solo l'esito dell'invio all'AEAT.
model RegistroVerifactu {
  id               Int       @id @default(autoincrement())
  fatturaId        Int
  fattura          Fattura   @relation(fields: [fatturaId], references: [id], onDelete: Restrict)
  ambiente         String // prova | produzione (due catene distinte)
  tipo             String // alta | anulacion
  subsanacion      Boolean   @default(false)
  nifEmittente     String
  numSerie         String
  dataFattura      String // DD-MM-AAAA, come nel registro
  huellaPrecedente String?
  huella           String
  generatoIl       String // FechaHoraHusoGenRegistro
  xml              String
  stato            String    @default("in_coda") // in_coda | accettato | accettato_con_errori | rifiutato
  csv              String? // codice di verifica della ricezione AEAT
  codiceErrore     String?
  descrizioneErrore String?
  risposta         String? // risposta AEAT (XML)
  tentativi        Int       @default(0)
  ultimoErrore     String? // ultimo problema d'invio (rete, certificato)
  inviatoIl        DateTime?
  createdAt        DateTime  @default(now())

  @@index([fatturaId])
  @@index([ambiente, id])
  @@index([stato])
}

// Solleciti di pagamento registrati su una fattura (come i reminders di
// Northstar): canale email | telefono | whatsapp | altro, con nota libera.
model Sollecito {
  id        Int      @id @default(autoincrement())
  fatturaId Int
  fattura   Fattura  @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  data      DateTime @default(now())
  canale    String   @default("email")
  nota      String?
  createdAt DateTime @default(now())

  @@index([fatturaId])
}

// Impostazioni dell'app (JSON per chiave). Chiave "fatture": dati emittente,
// fiscalità, pagamento, numerazione, PDF, testi dei solleciti.
model Impostazione {
  chiave    String   @id
  valore    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model Acconto {
  id               Int      @id @default(autoincrement())
  fatturaId        Int
  fattura          Fattura  @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  importo          Float
  data             DateTime
  metodoPagamento  String?
  note             String?
  createdAt        DateTime @default(now())
  abbinamentiBancari AbbinamentoBancario[]

  @@index([fatturaId])
}

model AltroIngresso {
  id          Int       @id @default(autoincrement())
  fonte       String
  categoria   String? // cashback | rimborso_tasse | apporto_socio | incasso_senza_fattura | ritenuta_commerciale | altro
  azienda     String    @default("Spagna")
  aziendaNota String?
  descrizione String?
  mese        Int
  anno        Int       @default(2025)
  importo     Float
  incassato   Boolean   @default(false)
  dataIncasso DateTime?
  fatturaId   Int?
  fattura     Fattura?  @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  abbinamentiBancari AbbinamentoBancario[]
}

model SpesaFissa {
  id            Int      @id @default(autoincrement())
  tipo          String
  cadenza       String
  dataPagamento String
  costo         Float    @default(0)
  costoMensile  Float    @default(0)
  ordine        Int      @default(0)
  createdAt     DateTime @default(now())
}

model Spesa {
  id           Int      @id @default(autoincrement())
  azienda      String   @default("Spagna")
  aziendaNota  String?
  fornitore    String
  fornitoreId  Int?
  categoria    String
  descrizione  String?
  note         String?
  ricevutaPath String?
  mese         Int
  anno         Int      @default(2025)
  importo      Float
  fatturaId    Int?
  fattura      Fattura? @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  pagamentoMensile PagamentoMensile?
  abbinamentiBancari AbbinamentoBancario[]
}

model Fornitore {
  id          Int      @id @default(autoincrement())
  nome        String
  paese       String   @default("Italia")
  email       String?
  telefono    String?
  partitaIva  String?
  via         String?
  cap         String?
  citta       String?
  provincia   String?
  note        String?
  createdAt   DateTime          @default(now())
  fattureFile FatturaFornitore[]
}

model FatturaFornitore {
  id            Int        @id @default(autoincrement())
  fileName      String
  filePath      String?
  fileData      String?    @db.Text
  fileMimeType  String?
  fornitoreId   Int?
  fornitore     Fornitore? @relation(fields: [fornitoreId], references: [id], onDelete: SetNull)
  mese          Int
  anno          Int
  importo       Float      @default(0)
  dataFattura   DateTime?
  createdAt     DateTime   @default(now())
}

model Documento {
  id              Int      @id @default(autoincrement())
  nome            String?
  categoria       String?
  socio           String?
  fileName        String
  fileData        String   @db.Text
  fileMimeType    String
  dataCaricamento DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Dipendente {
  id               Int       @id @default(autoincrement())
  nome             String
  cognome          String?
  ruolo            String?
  dataNascita      DateTime?
  dni              String?
  nie              String?
  numSS            String?
  via              String?
  cap              String?
  citta            String?
  provincia        String?
  paese            String?   @default("Spagna")
  telefono         String?
  email            String?
  iban             String?
  fotoPath         String?
  nettoBustaPaga   Float     @default(0)
  irpf             Float     @default(0)
  irpfImporto      Float     @default(0)
  seguridadSocial  Float     @default(0)
  // Tipologia: dipendente | socio_dipendente | commerciale
  tipo                   String  @default("dipendente")
  percentualeCommissione Float   @default(0) // solo commerciale: % sulle fatture incassate
  rimborsiMensili        Float   @default(0) // default mensile (socio dipendente)
  benefitMensili         Float   @default(0) // default mensile
  attivo                 Boolean @default(true)
  createdAt        DateTime  @default(now())
  pagamenti        PagamentoDipendente[]
  pagamentiMensili PagamentoMensile[]
  fattureCommerciale Fattura[] @relation("FatturaCommerciale")
}

// Registro pagamenti mensili per persona: una riga per voce (stipendio,
// seguridad, irpf, rimborsi, benefit, commissioni). Ogni riga ha la sua
// Spesa collegata, così i totali finance restano coerenti. Le commissioni
// nascono in automatico dalle fatture incassate con commerciale assegnato.
model PagamentoMensile {
  id           Int        @id @default(autoincrement())
  dipendenteId Int
  dipendente   Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)
  anno         Int
  mese         Int
  voce         String
  importo      Float
  data         DateTime?
  note         String?
  spesaId      Int?       @unique
  spesa        Spesa?     @relation(fields: [spesaId], references: [id], onDelete: SetNull)
  fatturaId    Int? // commissioni: fattura di origine
  fattura      Fattura?   @relation("CommissioneFattura", fields: [fatturaId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([anno, mese])
  @@index([dipendenteId, anno])
  @@index([fatturaId])
}

model PagamentoDipendente {
  id            Int        @id @default(autoincrement())
  dipendenteId  Int
  dipendente    Dipendente @relation(fields: [dipendenteId], references: [id], onDelete: Cascade)
  anno          Int
  mese          Int
  tipo          String     // 'stipendio' | 'seguridad'
  spesaId       Int?
  createdAt     DateTime   @default(now())

  @@unique([dipendenteId, anno, mese, tipo])
}

// Contatto = persona di riferimento di un cliente o di un lead (come i
// "contacts" di Northstar). I campi anagrafici azienda (paese, partitaIva,
// indirizzo, status) sono storici: restano nel DB ma l'interfaccia usa
// clienteId / leadId.
model Contatto {
  id         Int      @id @default(autoincrement())
  nome       String
  cognome    String?
  ruolo      String?
  paese      String   @default("Italia")
  email      String?
  telefono   String?
  partitaIva String?
  via        String?
  cap        String?
  citta      String?
  provincia  String?
  note       String?
  status     String   @default("lead") // storico
  clienteId  Int?
  cliente    Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  leadId     Int?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  principale Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([clienteId])
  @@index([leadId])
}

// Lead = potenziale cliente (modello Northstar): stato di pipeline, fonte,
// responsabile, attività con esito e prossima azione, conversione in cliente.
// `stage` è il vecchio campo del kanban: resta ma non si usa più.
model Lead {
  id         Int           @id @default(autoincrement())
  codice     String?       @unique // LEAD-2026-0001
  nome       String
  azienda    String?
  email      String?
  telefono   String?
  valore     Float?
  stage      String        @default("nuovo") // storico
  stato      String        @default("nuovo") // nuovo | contattato | qualificato | prospect | opportunita | vinta | persa | non_qualificato
  fonte      String?       // sito | referral | social | evento | passaparola | import | altro
  fonteDettaglio String?
  responsabile String?
  qualifica  String        @default("fredda") // fredda | tiepida | calda
  priorita   String        @default("media") // bassa | media | alta
  paese      String?
  citta      String?
  partitaIva String?
  sitoWeb    String?
  settore    String?
  prossimaAzione     String?
  prossimaAzioneData DateTime?
  clienteId  Int?
  cliente    Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  convertitoIl DateTime?
  legacyContattoId Int?    @unique // Contatto da cui è nato (script di conversione)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  appunti    AppuntoCall[]
  preventivi Preventivo[]
  attivita   AttivitaLead[]
  contatti   Contatto[]

  @@index([stato])
  @@index([clienteId])
}

// Attività su un lead: chiamata, email, riunione, nota, whatsapp, task;
// esito e prossima azione con data (come le activities di Northstar).
model AttivitaLead {
  id                 Int       @id @default(autoincrement())
  leadId             Int
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo               String    @default("nota")
  oggetto            String?
  descrizione        String?
  esito              String?   // positivo | neutro | negativo
  prossimaAzione     String?
  prossimaAzioneData DateTime?
  completata         Boolean   @default(false)
  data               DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@index([leadId])
}

model AppuntoCall {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  testo     String
  createdAt DateTime @default(now())
}

model Preventivo {
  id             Int          @id @default(autoincrement())
  numero         String
  nomeCliente    String
  emailCliente   String?
  aziendaCliente String?
  azienda        String       @default("Spagna")
  oggetto        String
  voci           String
  iva            Float        @default(21)
  subtotale      Float        @default(0)
  totale         Float        @default(0)
  feeCommerciale Float        @default(0)
  leadId         Int?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status         String       @default("attesa")
  note           String?
  condizioni     String?
  dataScadenza   DateTime?
  lingua         String       @default("it") // it | es | en
  createdAt      DateTime     @default(now())
  contratti      Contratto[]
}

model Contratto {
  id                   Int         @id @default(autoincrement())
  numero               String      @unique
  preventivoId         Int?
  preventivo           Preventivo? @relation(fields: [preventivoId], references: [id], onDelete: SetNull)
  clienteId            Int?
  cliente              Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nomeClienteFallback  String?
  rappresentanteLegale String
  dataDecorrenza       DateTime
  durataMesi           Int         @default(6)
  importoMensile       Float
  numeroRate           Int         @default(6)
  totaleContratto      Float
  oggetto              String
  voci                 String
  lingua               String      @default("it") // it | es
  status               String      @default("bozza") // bozza | inviato | firmato
  note                 String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  fatture              Fattura[]
  richiesteFattura     RichiestaFattura[]
}

// Richiesta di fattura ("fattura da emettere", come le planned invoices di
// Northstar). Nasce a mano o da un contratto, viene validata, poi convertita
// in una Fattura vera (fatturaId). Da quel momento emessa/incassata si leggono
// dalla fattura collegata; prima valgono i flag manuali.
model RichiestaFattura {
  id              Int        @id @default(autoincrement())
  codice          String     @unique // RF-2026-0001
  clienteId       Int?
  cliente         Cliente?   @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nomeCliente     String? // fallback se il cliente non è in anagrafica
  contrattoId     Int?
  contratto       Contratto? @relation(fields: [contrattoId], references: [id], onDelete: SetNull)
  azienda         String     @default("Spagna") // Spagna | Italia | Altro (come Fattura)
  aziendaNota     String?
  descrizione     String
  voci            String     @default("[]") // JSON [{ descrizione, importo }]
  imponibile      Float      @default(0)
  tipoIva         String     @default("igic_exenta") // igic_exenta | igic7 | iva
  iva             Float      @default(0) // percentuale
  totale          Float      @default(0)
  mese            Int
  anno            Int
  dataInvio       DateTime? // data prevista di emissione
  serieCodice     String? // codice della serie (ricorrenza o numero contratto)
  serieIndice     Int?
  serieTotale     Int?
  ricorrenza      String     @default("una_tantum") // una_tantum | mensile | trimestrale | annuale
  responsabile    String? // commerciale di riferimento
  validazione     String     @default("in_attesa") // in_attesa | ok
  validataIl      DateTime?
  emessa          Boolean    @default(false) // flag manuale finché non c'è fatturaId
  emessaIl        DateTime?
  incassata       Boolean    @default(false) // flag manuale finché non c'è fatturaId
  fatturaId       Int?       @unique
  fattura         Fattura?   @relation(fields: [fatturaId], references: [id], onDelete: SetNull)
  origine         String     @default("manuale") // manuale | contratto | legacy_sales | rinnovo
  legacyFatturaId Int?       @unique // vecchia Fattura origine=sales da cui è stata convertita
  // Rinnovo del sito da cui è nata e la scadenza che copre: una richiesta
  // per ogni scadenza, così «Rinnovato» (+12 mesi) apre un ciclo nuovo.
  rinnovoId       Int?
  rinnovo         RinnovoSito? @relation(fields: [rinnovoId], references: [id], onDelete: SetNull)
  rinnovoScadenza DateTime?
  note            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([anno, mese])
  @@index([clienteId])
  @@index([contrattoId])
  @@index([serieCodice])
  @@index([rinnovoId])
}

// Rinnovi dei siti web (Sales › Rinnovi siti): dominio, scadenza e prezzo
// di rinnovo annuo. Da qui nasce la richiesta di fattura del rinnovo,
// ANTICIPO_GIORNI prima della scadenza (lib/rinnovi.ts).
model RinnovoSito {
  id           Int       @id @default(autoincrement())
  dominio      String    @unique
  clienteId    Int?
  cliente      Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nomeCliente  String? // promemoria se il cliente non è in anagrafica
  scadenza     DateTime // prossima scadenza del dominio
  importo      Float     @default(0) // prezzo di rinnovo annuo (imponibile)
  fatturazione String    @default("rinnovo") // rinnovo (si fattura) | compresa (in un'altra gestione) | nessuna (sito nostro)
  stato        String    @default("attivo") // attivo | in_lavorazione | in_dubbio | non_attivo
  hosting      String?
  proprieta    String    @default("nostra") // nostra | cliente
  accesso      String? // account con cui si entra nell'hosting (solo scheda)
  note         String?
  rinnovatoIl  DateTime? // ultimo «Rinnovato»
  richieste    RichiestaFattura[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([scadenza])
  @@index([clienteId])
}

// ─── Banca (Fase 3) ────────────────────────────────────────────────────
// Estratto conto importato da file BBVA "Histórico movimientos" (XLSX).
// Il file non viene conservato: restano hash, periodo e conteggi.
model ImportBancario {
  id             Int       @id @default(autoincrement())
  banca          String    @default("BBVA")
  nomeFile       String
  hashFile       String
  conto          String?
  titolare       String?
  periodoDa      DateTime?
  periodoA       DateTime?
  righeLette     Int       @default(0)
  righeNuove     Int       @default(0)
  righeDuplicate Int       @default(0)
  createdAt      DateTime  @default(now())
  movimenti      MovimentoBancario[]
}

// Singolo movimento dell'estratto. importo con segno (negativo = uscita).
// impronta = riferimento univoco della banca (colonna REMESA) oppure hash
// dei campi: lo stesso movimento caricato da due file non si duplica.
// stato: da_abbinare | abbinato (collegato a record esistenti) |
//        spesa_creata (la Spesa è nata da qui) | escluso
model MovimentoBancario {
  id            Int       @id @default(autoincrement())
  importId      Int
  import        ImportBancario @relation(fields: [importId], references: [id], onDelete: Cascade)
  impronta      String    @unique
  dataContabile DateTime
  dataValore    DateTime?
  codice        String?
  concetto      String
  beneficiario  String?
  osservazioni  String?
  importo       Float
  saldo         Float?
  stato         String    @default("da_abbinare")
  nota          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  abbinamenti   AbbinamentoBancario[]

  @@index([dataContabile])
  @@index([stato])
  @@index([importId])
}

// Collegamento movimento ↔ record interno (una riga per record): Spesa per
// le uscite; Fattura / Acconto / AltroIngresso per le entrate (Fase 4).
model AbbinamentoBancario {
  id              Int       @id @default(autoincrement())
  movimentoId     Int
  movimento       MovimentoBancario @relation(fields: [movimentoId], references: [id], onDelete: Cascade)
  spesaId         Int?
  spesa           Spesa?    @relation(fields: [spesaId], references: [id], onDelete: Cascade)
  fatturaId       Int?
  fattura         Fattura?  @relation(fields: [fatturaId], references: [id], onDelete: Cascade)
  accontoId       Int?
  acconto         Acconto?  @relation(fields: [accontoId], references: [id], onDelete: Cascade)
  altroIngressoId Int?
  altroIngresso   AltroIngresso? @relation(fields: [altroIngressoId], references: [id], onDelete: Cascade)
  importo         Float
  createdAt       DateTime  @default(now())

  @@index([movimentoId])
  @@index([spesaId])
  @@index([fatturaId])
  @@index([accontoId])
  @@index([altroIngressoId])
}
